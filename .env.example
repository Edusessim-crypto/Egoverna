# Analytics — preencha apenas os que forem realmente utilizados.
# Sem estas variáveis, nenhum script de terceiros é carregado.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://egoverna.com.br

# Destino do formulário de contato.
# Se vazio, o envio é registrado no log do servidor e o usuário recebe confirmação.
CONTACT_WEBHOOK_URL=

# Caixa que recebe as solicitacoes do formulario (usada nos links de e-mail)
CONTACT_EMAIL=comercial@egoverna.com.br
